    "markdown-it": "^15.0.0",
    "md-editor-v3": "^6.5.6",
    "monaco-editor": "^0.56.0",
    "path": "^0.12.7",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode.vue": "^3.10.0",
    "smooth-signature": "^1.1.0",
    "sortablejs": "^1.15.7",
    "sql-formatter": "^15.8.2",
    "tailwindcss": "^4.3.3",
    "thememirror": "^2.0.1",
    "three": "^0.185.1",
    "uuid": "^14.0.1",
    "vanilla-jsoneditor": "^3.13.0",
    "vite-plugin-copy": "^0.1.6",
